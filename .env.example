# BunnyEra AI Provider Runtime
# Supported values: mock | openrouter | groq | gemini | ollama
# Default to mock for local demos and CI. Do not commit real keys in .env.
AI_PROVIDER=mock

# Local provider. Requires Ollama running locally; no API key required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Free-tier cloud providers. Leave keys empty to fallback to mock safely.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
